# Copy this file to terraform.tfvars and fill in your actual values
# DO NOT commit terraform.tfvars to git - it contains secrets!

slack_signing_secret = "your-slack-signing-secret-here"
slack_bot_token      = "xoxb-your-slack-bot-token-here"

# Optional: override the Bedrock model (default is Amazon Nova Lite).
# Switch to a Claude model once Anthropic model access is approved in Bedrock.
# bedrock_model_id = "amazon.nova-pro-v1:0"
# bedrock_model_id = "anthropic.claude-haiku-4-5-20251001-v1:0"

# Optional: leave empty for AWS auto-generation (recommended)
# api_gateway_api_key = ""

# Optional: ScrapingAnt API key to enable the r/ffxi last-resort Reddit search
# tool. Leave empty (or omit) to keep the tool dormant.
# scrapingant_api_key = ""
