# Copy this file to terraform.tfvars and fill in your actual values
# DO NOT commit terraform.tfvars to git - it contains secrets!

slack_signing_secret = "your-slack-signing-secret-here"
slack_bot_token      = "xoxb-your-slack-bot-token-here"

# Optional: override the Bedrock model (default is Amazon Nova Lite).
# Switch to a Claude model once Anthropic model access is approved in Bedrock.
# bedrock_model_id = "amazon.nova-pro-v1:0"
# bedrock_model_id = "anthropic.claude-haiku-4-5-20251001-v1:0"

# Optional: override the deep-planning tier model. Complex, multi-step questions
# are escalated from bedrock_model_id to this more capable model.
# planner_model_id = "us.anthropic.claude-sonnet-4-6"

# Kill-switch for the expensive planner tier. Defaults to false (disabled).
# Set true to allow escalation to planner_model_id.
# enable_planner_escalation = true

# Cost governance (AWS Budgets + Cost Anomaly Detection). All alerts route to
# the notifications SNS topic -> #code-testing via AWS Chatbot. Defaults shown.
# monthly_budget_limit         = 10  # total-account monthly budget (USD)
# bedrock_monthly_budget_limit = 8   # Amazon Bedrock-only monthly budget (USD)
# anomaly_alert_threshold      = 5   # min $ impact of a Bedrock anomaly to alert
# budget_alert_emails          = ["tom@steigertech.com", "tsteiger@gmail.com"]
# NOTE: the Bedrock budget's forecasted-100% threshold also auto-throttles the
# bot to zero concurrency (runaway shutdown). Recover with the
# runaway_recovery_command output.

# Optional: Slack channel for per-request operation logs (question, time, tools
# called). Defaults to #code-testing (C03HE46DXC7). Empty string disables the
# Slack post (CloudWatch ops logging always stays on). The bot must be a member
# of this channel to post.
# ops_log_channel_id = "C03HE46DXC7"

# Optional: leave empty for AWS auto-generation (recommended)
# api_gateway_api_key = ""

# Optional: ScrapingAnt API key to enable the r/ffxi last-resort Reddit search
# tool. Leave empty (or omit) to keep the tool dormant.
# scrapingant_api_key = ""
